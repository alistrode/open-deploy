[Unit]
Description=OpenDeploy SSH Relay 3.0 host control channel
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
UMask=0077
Environment=RELAY_STATE_DIR=/var/lib/opendeploy/relay3
Environment=RELAY_NO_PRINT=1
WorkingDirectory=/opt/opendeploy/relay/SSH-Remote-Linux
ExecStart=/opt/opendeploy/relay/SSH-Remote-Linux/runtime/node /opt/opendeploy/relay-supervisor.cjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
